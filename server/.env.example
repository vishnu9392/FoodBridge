# FoodBridge Server Configuration

# Port to listen on (Default: 5000)
PORT=5000

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/foodbridge?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secret Key for Signing Authentication Tokens
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Client Application URL for CORS
CLIENT_ORIGIN=http://localhost:5173
